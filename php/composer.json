{
    "name": "oojs/oojs",
    "description": "Object-Oriented JSON Schema — PHP implementation",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10 || ^11"
    },
    "autoload": {
        "psr-4": {
            "Oojs\\": "src/"
        },
        "files": [
            "src/Validator.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Oojs\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
