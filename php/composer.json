{
    "name": "oojs/oojs",
    "description": "Object-Oriented JSON Schema — PHP implementation",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": ["json-schema", "oojs", "object-oriented", "validation", "schema"],
    "homepage": "https://github.com/pablopazos/json-object-schema",
    "support": {
        "source": "https://github.com/pablopazos/json-object-schema/tree/master/php",
        "issues": "https://github.com/pablopazos/json-object-schema/issues"
    },
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10 || ^11"
    },
    "autoload": {
        "psr-4": {
            "Oojs\\": "src/"
        },
        "files": [
            "src/Validator.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Oojs\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
